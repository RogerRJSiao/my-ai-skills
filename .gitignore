# ── 輸出檔案（本地測試產出，不納入版控）──
outputs/
**/outputs/

# ── assets 內的 xlsx 範本【保留】，其餘 xlsx 排除 ──
# （各 skill 若有子資料夾或工作區的規則，寫在該 skill 資料夾自己的 .gitignore）
*.xlsx
!skills/**/assets/*.xlsx

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
skills/08-auto-screenshot/auto_printscript/

# ── 08-auto-screenshot 執行產出（截圖與合併 PDF）──
skills/08-auto-screenshot/output/

# ── 系統 / 編輯器 ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 敏感資料 ──
.env
secrets.json

# ── 機器本機路徑設定（因人而異，不納入版控）──
skills/**/scripts/local_config.json

# ── sample-data 內的 PDF（避免上傳銀行資料）──
skills/**/sample-data/*.pdf
# 豁免 bank_ 開頭的公開優惠頁面 PDF（無個資）
!skills/**/sample-data/bank_*.pdf
# 豁免 references/ 內的 PDF（AI 對話紀錄等參考文件）
!skills/**/references/*.pdf
